+/* QQBotLocalPatch:session-cmd-context+fork-timeout (2026-11-15 重打，适配 1.13.6)
+ * ① scope/peer 兜底：getScopePeer 直接读 msg.kind，命令无 message 上下文（web/dock/兜底调用）时会抛
+ *    TypeError；用 caps.replyTarget 兜底，两者都没有才抛明确错误。
+ * ② /bot-new fork 超时：宿主卡住时 startNewSession 可能长时间不返回 → QQ 侧永远等不到回复；
+ *    加 Promise.race 超时（默认 20s，可用 QQBOT_FORK_TIMEOUT_MS 覆盖，下限 1s）。
+ */
+const FORK_TIMEOUT_MS = Math.max(1000, Number(process.env.QQBOT_FORK_TIMEOUT_MS) || 20_000);
+function scopePeerOf(cmdCtx) {
+    try {
+        return getScopePeer(cmdCtx);
+    }
+    catch {
+        const t = cmdCtx?.caps?.replyTarget ?? cmdCtx?.replyTarget ?? {};
+        const scope = String(t.scope ?? '');
+        const peerId = String(t.targetId ?? t.peerId ?? '');
+        if (scope && peerId)
+            return { scope, peerId };
+        throw new Error('命令上下文缺失（既没有 message，也没有 replyTarget）');
+    }
+}
+/** 超时返回哨兵字符串 'timeout'（不抛）——宿主卡住时 QQ 侧要拿到**人话**而不是异常。 */
+function forkWithTimeout(promise) {
+    return Promise.race([
+        promise,
+        new Promise((resolve) => setTimeout(() => resolve('timeout'), FORK_TIMEOUT_MS)),
+    ]);
+}
